# Browser-visible Google OAuth client ID (safe to expose; restrict the OAuth client by origin)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Frontend API path. Keep /api for Vercel and local Vite proxy.
VITE_API_BASE=/api

# Server-side Apps Script URL. Never prefix this with VITE_.
# For local development Vite uses it as a proxy target.
GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
